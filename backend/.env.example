# Copy this file to `.env` and fill in the values.
# `.env` must never be committed: it is already in .gitignore.

ENV=dev

# Development: SQLite. Production: the Neon connection string (EU region).
DATABASE_URL=sqlite:///./dev.db

# Argon2id hash of the access password.
# Generate with:  uv run python -m app.hashpw
APP_PASSWORD_HASH=

# Key used to sign session tokens.
# Generate with:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Session lifetime in days (renewed on every app launch).
SESSION_DAYS=30

# Hard cap for a single attachment, in bytes (10 MB).
MAX_UPLOAD_BYTES=10000000
